{
  "name": "deliverproof",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.18.3 <21 || >=22.18.0 <23 || >=24.0.0 <25"
  },
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "packages/core",
    "packages/hardhat",
    "packages/nextjs"
  ],
  "scripts": {
    "check": "npm run typecheck -w @deliverproof/core",
    "test": "npm run test -w @deliverproof/core && npm run test -w @sh/hardhat",
    "core:test": "npm run test -w @deliverproof/core",
    "hardhat:test": "npm run test -w @sh/hardhat",
    "hardhat:compile": "npm run compile -w @sh/hardhat",
    "hardhat:node": "npm run node -w @sh/hardhat",
    "hardhat:deploy:local": "npm run deploy:local -w @sh/hardhat",
    "hardhat:deploy:testnet": "npm run deploy:testnet -w @sh/hardhat",
    "next:dev": "npm run dev -w @sh/nextjs",
    "next:build": "npm run build -w @sh/nextjs",
    "next:check": "npm run check-types -w @sh/nextjs",
    "next:lint": "npm run lint -w @sh/nextjs",
    "next:start": "npm run start -w @sh/nextjs",
    "chain:test": "npm run hardhat:compile && npm run typecheck:chain -w @deliverproof/core && npm run test:chain -w @deliverproof/core",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9"
  },
  "overrides": {
    "@hiero-ledger/sdk": {
      "ethers": "6.17.0"
    }
  }
}
